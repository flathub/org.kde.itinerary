                        "project-id": 101246,
                        "stable-only": true,
                        "url-template": "https://github.com/zxing-cpp/zxing-cpp/archive/v$version.tar.gz"
                    }
                }
            ]
        },
        {
            "name": "kitinerary",
            "config-opts": [
                "-DBUILD_TESTING=OFF",
                "-DBUILD_TOOLS=OFF"
            ],
            "buildsystem": "cmake-ninja",
            "builddir": true,
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/release-service/26.08.0/src/kitinerary-26.08.0.tar.xz",
                    "sha256": "b90eeba1507d99e0d911066955031854273938ff1e4f39f9cd4173f4a549515c",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 8763,
                        "stable-only": true,
                        "url-template": "https://download.kde.org/stable/release-service/$version/src/kitinerary-$version.tar.xz"
                    }
                }
            ],
            "cleanup": [
                "/lib/libexec"
            ]
        },
        {
            "name": "kpublictransport",
            "config-opts": [
                "-DBUILD_TESTING=OFF"
            ],
            "buildsystem": "cmake-ninja",
            "builddir": true,
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/release-service/26.08.0/src/kpublictransport-26.08.0.tar.xz",
                    "sha256": "02c84e01ae0b4838a2c3d40acb8b1d4148997131fee305a292e98fd4cd17de71",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 8763,
                        "stable-only": true,
                        "url-template": "https://download.kde.org/stable/release-service/$version/src/kpublictransport-$version.tar.xz"
                    }
                }
            ]
        },
        {
            "name": "kopeninghours",
            "config-opts": [
                "-DBUILD_TESTING=OFF",
                "-DBUILD_WITH_QT6=ON"
            ],
            "buildsystem": "cmake-ninja",
            "builddir": true,
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/release-service/26.08.0/src/kopeninghours-26.08.0.tar.xz",
                    "sha256": "b53e954f60bdebcfff1e5744b1ca62cd96065f01b25eff8f9976c75b1827862c",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 8763,
                        "stable-only": true,
                        "url-template": "https://download.kde.org/stable/release-service/$version/src/kopeninghours-$version.tar.xz"
                    }
                }
            ]
        },
        {
            "name": "kosmindoormap",
            "config-opts": [
                "-DBUILD_TESTING=OFF"
            ],
            "buildsystem": "cmake-ninja",
            "builddir": true,
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/release-service/26.08.0/src/kosmindoormap-26.08.0.tar.xz",
                    "sha256": "c37e3f537f12964f3aeecc9e2acf7e59618afc230a3c69ca02d53507099f7761",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 8763,
                        "stable-only": true,
                        "url-template": "https://download.kde.org/stable/release-service/$version/src/kosmindoormap-$version.tar.xz"
                    }
                }
            ]
        },
        {
            "name": "khealthcertificate",
            "config-opts": [
                "-DBUILD_TESTING=OFF"
            ],
            "buildsystem": "cmake-ninja",
            "builddir": true,
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/release-service/26.08.0/src/khealthcertificate-26.08.0.tar.xz",
                    "sha256": "112b82ff15cc3de2fb7ce7b65c4b41126f34d4c90f9059c7d2f4a571227ef295",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 8763,
                        "stable-only": true,
                        "url-template": "https://download.kde.org/stable/release-service/$version/src/khealthcertificate-$version.tar.xz"
                    }
                }
            ]
        },
        {
            "name": "libQuotient",
            "buildsystem": "cmake-ninja",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/quotient-im/libQuotient/archive/0.9.6.1.tar.gz",
                    "sha256": "ac0fe5df480fa893d3e16da626bf5028c944e9b41f504f6fe0fe49273247d636",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 89357,
                        "stable-only": true,
                        "url-template": "https://github.com/quotient-im/libQuotient/archive/$version.tar.gz"
                    }
                }
            ],
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=Release",
                "-DQuotient_ENABLE_E2EE=ON",
                "-DBUILD_TESTING=OFF",
                "-DBUILD_WITH_QT6=ON"
            ],
            "cleanup": [
                "/share/ndk-modules"
            ],
            "modules": [
                {
                    "name": "olm",
                    "buildsystem": "cmake-ninja",
                    "builddir": true,
                    "config-opts": [
                        "-DOLM_TESTS=OFF",
                        "-DCMAKE_BUILD_TYPE=Release",
                        "-DCMAKE_POLICY_VERSION_MINIMUM=3.5"
                    ],
                    "sources": [
                        {
                            "type": "archive",
                            "url": "https://gitlab.matrix.org/matrix-org/olm/-/archive/3.2.16/olm-3.2.16.tar.gz",
                            "sha256": "1e90f9891009965fd064be747616da46b232086fe270b77605ec9bda34272a68",
                            "x-checker-data": {
                                "type": "anitya",
                                "project-id": 29706,
                                "url-template": "https://gitlab.matrix.org/matrix-org/olm/-/archive/$version/olm-$version.tar.gz"
                            }
                        }
                    ]
                }
            ]
        },
        {
            "name": "maplibre-native-qt",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DBUILD_TESTING=OFF",
                "-DMLN_QT_WITH_WIDGETS=OFF",
                "-DMLN_WITH_OPENGL=ON",
                "-DMLN_WITH_VULKAN=OFF",
                "-DMLN_WITH_WERROR=OFF"
            ],
            "post-install": [
                "mv /app/plugins/ /app/lib/",
                "mv /app/qml/* /app/lib/qml/",
                "sed -i 's,/plugins/,/lib/plugins/,g' /app/lib/cmake/QMapLibre/*.cmake",
                "sed -i 's,/qml/,/lib/qml/,g' /app/lib/cmake/QMapLibre/*.cmake"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/maplibre/maplibre-native-qt/",
                    "commit": "181f28b8d147d10b9160e106694fbca811c911b9"
                }
            ]
        },
        {
            "name": "itinerary",
            "buildsystem": "cmake-ninja",
            "builddir": true,
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/release-service/26.08.0/src/itinerary-26.08.0.tar.xz",
                    "sha256": "21df6501f6eb723eb0522e73a919346847a714383a55f241d5bc6f2a5061892e",
                    "x-checker-data": {
                        "is-main-source": true,
                        "type": "anitya",
                        "project-id": 8763,
                        "stable-only": true,
                        "url-template": "https://download.kde.org/stable/release-service/$version/src/itinerary-$version.tar.xz"
                    }
                }
            ],
            "config-opts": [
                "-DBUILD_TESTING=OFF",
                "-DCMAKE_DISABLE_FIND_PACKAGE_KF6KIO=ON",
                "-DCMAKE_DISABLE_FIND_PACKAGE_KF6FileMetaData=ON",
                "-DFLATPAK_BUILD=ON"
            ]
        }
    ]
}
